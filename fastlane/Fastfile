# Build Cars (app + widget) and upload it to TestFlight, using the same GitHub
# secrets as the Loop/Trio Browser Build (TEAMID, GH_PAT, FASTLANE_KEY_ID,
# FASTLANE_ISSUER_ID, FASTLANE_KEY, MATCH_PASSWORD).

default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"]
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

APP_ID = "com.#{TEAMID}.carstatus"
WIDGET_ID = "com.#{TEAMID}.carstatus.widget"
TARGETS = { "CarStatus" => APP_ID, "CarStatusWidget" => WIDGET_ID }
PROJECT = "#{GITHUB_WORKSPACE}/CarStatus.xcodeproj"

def api_key!
  app_store_connect_api_key(
    key_id: FASTLANE_KEY_ID,
    issuer_id: FASTLANE_ISSUER_ID,
    key_content: FASTLANE_KEY
  )
end

def match_auth
  Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
end

platform :ios do
  desc "Register the app and widget bundle IDs and make their App Store profiles"
  lane :identifiers do
    setup_ci if ENV["CI"]
    api_key!

    { APP_ID => "Cars", WIDGET_ID => "Cars Widget" }.each do |id, name|
      bundle = Spaceship::ConnectAPI::BundleId.find(id) ||
        Spaceship::ConnectAPI::BundleId.create(name: name, identifier: id, platform: "IOS")
      UI.success("Bundle ID ready: #{bundle.identifier}")
    end

    match(
      type: "appstore",
      readonly: false,
      git_basic_authorization: match_auth,
      app_identifier: [APP_ID, WIDGET_ID]
    )
  end

  desc "Build a signed IPA"
  lane :build_app_ipa do
    setup_ci if ENV["CI"]
    key = api_key!

    update_project_team(path: PROJECT, teamid: TEAMID)

    previous = latest_testflight_build_number(app_identifier: APP_ID, api_key: key, initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: previous + 1)

    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: match_auth,
      app_identifier: [APP_ID, WIDGET_ID]
    )
    profiles = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    TARGETS.each do |target, id|
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        team_id: TEAMID,
        bundle_identifier: id,
        profile_name: profiles[id],
        code_sign_identity: "iPhone Distribution",
        targets: [target]
      )
    end

    gym(
      project: PROJECT,
      scheme: "CarStatus",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profiles[APP_ID], WIDGET_ID => profiles[WIDGET_ID] } },
      xcargs: "DEVELOPMENT_TEAM=#{TEAMID}",
      output_name: "CarStatus.ipa",
      destination: "generic/platform=iOS",
      buildlog_path: "buildlog"
    )
  end

  desc "Upload to TestFlight"
  lane :release do
    begin
      upload_to_testflight(
        api_key: api_key!,
        ipa: "CarStatus.ipa",
        skip_waiting_for_build_processing: true,
        changelog: "Built from commit #{last_git_commit[:abbreviated_commit_hash]}"
      )
    rescue => e
      # Xcode 27's uploader logs this harmless message after "UPLOAD SUCCEEDED",
      # and fastlane treats it as a failure.
      raise unless e.message.include?("CDUploaderStateInfoResumeFilePath")
      UI.important("Ignoring Xcode 27 uploader warning; the upload itself succeeded.")
    end
  end
end
